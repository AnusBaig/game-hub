# Environment Variables Template
# Copy this file to .env.local and replace with your actual values

# REQUIRED APIs
# =============

# RAWG API Key - Required for basic game data
# Get yours at https://rawg.io/apidocs
VITE_RAWG_API_KEY=your_rawg_api_key_here

# OPTIONAL APIs
# =============
# These APIs enhance the game media experience but are not required
# If not configured, the app will gracefully fallback to RAWG-only data

# YouTube Data API v3 - For gaming videos (trailers, gameplay)
# Get yours at https://console.developers.google.com/
# 1. Create a project in Google Cloud Console
# 2. Enable YouTube Data API v3
# 3. Create credentials (API key)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# IGDB API - For additional game media (screenshots, artwork)
# Get yours at https://api.igdb.com/ (requires Twitch app)
# 1. Create a Twitch app at https://dev.twitch.tv/console/apps
# 2. Use your Client ID and Client Secret here
VITE_IGDB_CLIENT_ID=your_twitch_client_id_here
VITE_IGDB_CLIENT_SECRET=your_twitch_client_secret_here

# Content Moderation APIs
# =======================

# Sightengine API - For content moderation/safety scoring
# Get yours at https://sightengine.com/
VITE_SIGHTENGINE_API_KEY=your_sightengine_api_key_here
VITE_SIGHTENGINE_API_SECRET=your_sightengine_api_secret_here

# DEPRECATED/UNUSED APIs
# ======================
# These are not currently used but kept for potential future integration

# Steam Web API - Steam data is accessed via public endpoints (no key needed)
# VITE_STEAM_API_KEY=your_steam_api_key_here

# Metacritic API - No public API available
# VITE_METACRITIC_API_KEY=your_metacritic_api_key_here